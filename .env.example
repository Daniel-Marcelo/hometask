# Supabase cloud backend (optional). Copy this file to .env.local and fill in
# both values to switch the app from localStorage to Supabase; leave them
# empty/absent to stay on the local repo.
#
# Project URL and anon (publishable) key: Supabase dashboard → Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Client-side invite allowlist (UX only — real enforcement is RLS in
# supabase/migrations/0001_init.sql via the allowed_emails table). Comma-
# separated; empty allows any email while unconfigured.
VITE_ALLOWED_EMAILS=
