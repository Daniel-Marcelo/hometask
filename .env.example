# Supabase cloud backend (optional). Copy this file to .env.local and fill in
# both values to switch the app from localStorage to Supabase; leave them
# empty/absent to stay on the local repo.
#
# Project URL and anon (publishable) key: Supabase dashboard → Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NOTE: env vars alone do NOT give working cloud mode. Every RLS policy in
# supabase/migrations/0001_init.sql is `to authenticated`, and src/lib/auth.ts
# is still the localStorage mock — users must actually sign in via Supabase
# auth for requests to pass RLS. Swapping auth.ts to real Supabase auth is a
# tracked follow-up.

# Client-side invite allowlist (UX only — real enforcement is RLS in
# supabase/migrations/0001_init.sql via the allowed_emails table). Comma-
# separated; empty allows any email while unconfigured.
VITE_ALLOWED_EMAILS=

# Emails seeded into the server-side allowed_emails table by
# scripts/seed-supabase.ts (comma-separated; requires the service-role key,
# so this is NOT read by the app bundle). Empty skips the allowlist step.
ALLOWED_EMAILS=
